# Copy to .env and adjust. Local development values only; never commit .env.

# Host port of the PostgreSQL container (change it if 5432 is used by another local database)
POSTGRES_PORT=5432

# Bootstrap superuser (used only by the image entrypoint to create the roles)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev

# Schema owner role, used by Flyway
APP_OWNER_PASSWORD=app-owner-dev

# Runtime role used by the backend (no superuser, no BYPASSRLS)
APP_USER_PASSWORD=app-user-dev

# HS256 secret that signs the access tokens; at least 32 bytes (ADR-0002)
JWT_SECRET=vesta-local-dev-secret-change-me-0123456789
