meta {
  name: Login com e-mail inexistente
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "ninguem@vesta.demo",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 401
  res.body.detail: eq "E-mail ou senha inválidos."
}

docs {
  Cenário N-9: e-mail inexistente recebe exatamente a mesma resposta da senha errada.
}
