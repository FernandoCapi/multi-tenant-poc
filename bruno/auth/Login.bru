meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
  res.body.tokenType: eq Bearer
  res.body.expiresIn: eq 3600
}

script:post-response {
  bru.setVar("token", res.body.accessToken);
}

docs {
  Login de um usuário demo da Família Silva. O token fica na variável `token` para as próximas requisições.
}
