meta {
  name: Carlos cria objetivo com family_id forjado
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/goals
  body: json
  auth: bearer
}

auth:bearer {
  token: {{carlosToken}}
}

body:json {
  {
    "title": "Presente de Natal",
    "targetAmount": 600.00,
    "familyId": "{{otherFamilyId}}"
  }
}

assert {
  res.status: eq 201
  res.body.myRole: eq OWNER
  res.body.status: eq ACTIVE
}

script:post-response {
  bru.setVar("createdGoalId", res.body.id);
}

docs {
  Cenário N-2: o familyId da Família Souza no corpo é ignorado; o objetivo nasce na família do token.
}
