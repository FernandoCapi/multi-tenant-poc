meta {
  name: Pedro acessa o Aluguel
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/goals/{{rentGoalId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{pedroToken}}
}

assert {
  res.status: eq 404
  res.body.detail: eq "Objetivo não encontrado."
}

docs {
  Cenário N-4: mesma família, sem vínculo com o objetivo. 404, sem revelar que o objetivo existe.
}
