meta {
  name: Carlos registra a própria
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/goals/{{contributionGoalId}}/contributions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{carlosToken}}
}

body:json {
  {
    "amount": 20.00
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("carlosContributionId", res.body.id);
}
